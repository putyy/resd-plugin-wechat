{
  "id": "official.wechat",
  "name": "WeChat Channels",
  "author": {
    "name": "putyy",
    "url": "https://github.com/putyy/resd-plugin-wechat"
  },
  "locales": {
    "zh-CN": {
      "name": "微信视频号",
      "description": "捕获微信视频号资源，并使用插件自带 WASM 处理加密媒体。"
    },
    "zh": {
      "name": "微信视频号",
      "description": "捕获微信视频号资源，并使用插件自带 WASM 处理加密媒体。"
    },
    "en": {
      "name": "WeChat Channels",
      "description": "Captures WeChat Channels resources and processes encrypted media with plugin-bundled WASM."
    }
  },
  "version": "1.0.5",
  "apiVersion": 1,
  "runtime": "javascript",
  "entry": "main.js",
  "priority": 1000,
  "permissions": {
    "domains": ["*.qq.com", "*.weixin.qq.com", "pull-m1.wxlivecdn.com"],
    "capabilities": [
      "observe-request",
      "read-request-body",
      "intercept-request",
      "observe-response",
      "read-response-body",
      "modify-response",
      "emit-resource",
      "process-download",
      "media.ffmpeg.network"
    ],
    "bodyLimit": 16777216
  },
  "match": [
    {
      "stage": "request",
      "host": "channels.weixin.qq.com",
      "path": "/res-downloader/wechat",
      "method": "POST",
      "readBody": true
    },
    {
      "stage": "request",
      "host": "channels.weixin.qq.com",
      "path": "/res-downloader/wechat",
      "readBody": false
    },
    {
      "stage": "response",
      "host": "*.qq.com",
      "contentTypes": ["video/*", "audio/video", "audio/video;*", "application/octet-stream", "application/octet-stream;*", "binary/octet-stream"],
      "readBody": false
    },
    {
      "stage": "response",
      "host": "channels.weixin.qq.com",
      "path": "/web/pages/*",
      "contentTypes": ["text/html", "text/html;*"],
      "readBody": true
    },
    {
      "stage": "response",
      "host": "res.wx.qq.com",
      "url": "*.js?v=*",
      "readBody": true
    },
    {
      "stage": "response",
      "host": "res.wx.qq.com",
      "path": "*web/web-finder/res/js/FinderHome.publish*.js",
      "readBody": true
    },
    {
      "stage": "response",
      "host": "res.wx.qq.com",
      "path": "*web/web-finder/res/js/AuthorObjectCard.vue_vue_type_style_index_1_lang.publish*.js",
      "readBody": true
    },
    {
      "stage": "response",
      "host": "res.wx.qq.com",
      "path": "*web/web-finder/res/js/useViewportProbe.publish*.js",
      "readBody": true
    },
    {
      "stage": "response",
      "host": "res.wx.qq.com",
      "path": "*web/web-finder/res/js/LiveStatBox.publish*.js",
      "readBody": true
    },
    {
      "stage": "response",
      "host": "*.qq.com",
      "url": "*.flv*",
      "readBody": false
    },
    {
      "stage": "response",
      "host": "pull-m1.wxlivecdn.com",
      "url": "*.flv*",
      "readBody": false
    },
    {
      "stage": "response",
      "host": "res.wx.qq.com",
      "path": "*web/web-finder/res/js/virtual_svg-icons-register.publish*.js",
      "readBody": true
    }
  ],
  "resourceKinds": [
    {
      "id": "media.video",
      "icon": "video",
      "color": "#2080f0",
      "locales": {
        "zh": {"name": "视频"},
        "en": {"name": "Video"}
      }
    },
    {
      "id": "stream.live",
      "icon": "video",
      "color": "#ee6c4d",
      "locales": {
        "zh": {"name": "直播"},
        "en": {"name": "Live stream"}
      }
    },
    {
      "id": "media.image",
      "icon": "image",
      "color": "#18a058",
      "locales": {
        "zh": {"name": "图片"},
        "en": {"name": "Image"}
      }
    }
  ],
  "processors": {
    "isaac64-prefix": {
      "runtime": "wasm",
      "entry": "decrypt.wasm",
      "apiVersion": 1
    }
  },
  "actions": {
    "decrypt-local-file": {
      "kind": "process-file",
      "processor": "isaac64-prefix",
      "inputExtensions": [".mp4"],
      "outputExtension": ".mp4",
      "locales": {
        "zh": {
          "name": "解密本地视频",
          "description": "处理通过复制链接并使用其他工具下载的微信视频号加密文件。"
        },
        "en": {
          "name": "Decrypt Local Video",
          "description": "Process an encrypted WeChat Channels file downloaded with another tool."
        }
      }
    }
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "quality": {
        "type": "string",
        "enum": ["default", "high", "medium", "low"],
        "default": "default",
        "x-locales": {
          "zh": {
            "name": "下载画质",
            "description": "选择下载时使用的清晰度策略。实际可用画质取决于当前视频号资源。"
          },
          "en": {
            "name": "Download quality",
            "description": "Select the quality strategy used for downloads. Available qualities depend on the current Channels resource."
          }
        },
        "x-enumLabels": {
          "zh": {
            "default": "默认",
            "high": "高清",
            "medium": "中等",
            "low": "低清"
          },
          "en": {
            "default": "Default",
            "high": "High",
            "medium": "Medium",
            "low": "Low"
          }
        }
      },
      "captureMode": {
        "type": "string",
        "enum": ["playback", "detail", "full"],
        "default": "playback",
        "x-locales": {
          "zh": {
            "name": "抓取模式",
            "description": "播放抓取在视频或图文开始播放时抓取；详情抓取在取得详情时抓取；完整抓取合并页面媒体、详情和播放。直播不受此设置影响。切换后请重新打开视频号。"
          },
          "en": {
            "name": "Capture mode",
            "description": "Capture on video or image-post playback, on detail responses, or from all page media, details and playback. Live capture is independent. Reopen Channels after switching."
          }
        },
        "x-enumLabels": {
          "zh": {
            "playback": "播放抓取",
            "detail": "详情抓取",
            "full": "完整抓取"
          },
          "en": {
            "playback": "Playback capture",
            "detail": "Detail capture",
            "full": "Full capture"
          }
        }
      },
      "enableLog": {
        "type": "boolean",
        "default": false,
        "x-locales": {
          "zh": {
            "name": "启用日志",
            "description": "记录播放器注入、探测和数据校验结果，默认关闭。"
          },
          "en": {
            "name": "Enable logging",
            "description": "Log player injection, probe and data validation results. Disabled by default."
          }
        }
      }
    }
  }
}
